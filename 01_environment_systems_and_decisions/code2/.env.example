# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# --- Tapo IP camera -------------------------------------------------------
# These are the *Camera Account* credentials created in the Tapo mobile app
# (Settings -> Advanced Settings -> Camera Account), NOT your TP-Link cloud login.
TAPO_USERNAME=camera_account_user
TAPO_PASSWORD=camera_account_password
IP_ADDRESS=192.168.1.100

# stream1 = main/HD, stream2 = sub/SD (lower CPU, use if HD stutters)
TAPO_STREAM=stream1
TAPO_RTSP_PORT=554

# Optional: bypass the values above with a full URL (any RTSP camera, not just Tapo)
# IPCAM_URL=rtsp://user:pass@192.168.1.100:554/stream1

# --- Local webcams --------------------------------------------------------
# Index maps to /dev/videoN. Run `ls /dev/video*` or `v4l2-ctl --list-devices`.
# Cameras often expose two nodes (0/1, 2/3) - the even one is usually the capture node.
WEBCAM_1_INDEX=0
WEBCAM_2_INDEX=2

# --- Display --------------------------------------------------------------
TARGET_FPS=25
WEBCAM_WIDTH=1280
WEBCAM_HEIGHT=720

# Network settings recorded for reference (not used by the app)
MASK=255.255.255.0
GATEWAY=192.168.1.1
DNS=192.168.1.1
